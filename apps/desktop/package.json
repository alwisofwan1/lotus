{
  "name": "@lotus/desktop",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "predev": "node scripts/free-port.mjs",
    "dev": "NODE_OPTIONS='--max-old-space-size=8192' next dev",
    "build": "next build",
    "build:tauri": "bun run mcp:bundle && bun scripts/prepare-next-build.mjs && NEXT_TELEMETRY_DISABLED=1 next build",
    "chat-bridge:bundle": "bun build scripts/chat-bridge/main.ts --target bun --outfile scripts/chat-bridge/dist/chat-bridge.mjs",
    "mcp:bundle": "bun build scripts/lotus-mcp-server.mjs --target node --format esm --outfile scripts/lotus-mcp-server.bundle.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "logos:build": "node scripts/build-brand-logos.mjs",
    "icons:build": "node scripts/build-app-icons.mjs",
    "clean:rust-temp": "node scripts/clean-rust-build-temp.mjs",
    "clean:stale": "node scripts/clean-rust-build-temp.mjs --stale",
    "tauri:dev": "bun run clean:rust-temp && bun run mcp:bundle && bun scripts/build-host-bundle.mjs && bun scripts/build-sessiond.mjs && tauri dev --config src-tauri/tauri.dev.conf.json",
    "tauri:build": "bun run tauri:build:exec",
    "tauri:build:exec": "bun scripts/check-release-env.mjs && bun run clean:rust-temp && bun run mcp:bundle && bun run chat-bridge:bundle && bun scripts/build-host-bundle.mjs && bun scripts/build-sessiond.mjs --release && rimraf out .next/cache && CI=true tauri build",
    "tauri:dev:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/tauri-dev-windows.ps1",
    "tauri:build:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/tauri-build-windows.ps1",
    "release": "bun scripts/release.mjs",
    "release:mac": "bun scripts/release-macos.mjs",
    "release:notes": "bun scripts/release-notes.mjs",
    "tauri:build:mac": "bun scripts/tauri-build-macos.mjs && bun run tauri:verify:mac",
    "tauri:verify:mac": "bash scripts/verify-macos-artifact.sh",
    "setup:linux": "bash scripts/install-linux-tauri-deps.sh"
  },
