{
  "$schema": "./gen/schemas/desktop-schema.json",
  "productName": "Lotus",
  "version": "0.20.0",
  "identifier": "com.lotus.desktop",
  "build": {
    "devUrl": "http://localhost:3001",
    "frontendDist": "../out",
    "beforeDevCommand": "PORT=3001 npm run dev",
    "beforeBuildCommand": "bun run build:tauri"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Lotus",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 19
        },
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "transparent": true,
        "windowEffects": {
          "effects": ["sidebar"],
          "state": "followsWindowActiveState"
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; img-src * data: blob: asset: http://asset.localhost; media-src * data: blob: asset: http://asset.localhost; font-src 'self' data: blob: https://cdn.jsdelivr.net; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost data: blob: https: wss:; frame-src 'self' blob: http://127.0.0.1:* https://www.youtube.com https://www.youtube-nocookie.com; worker-src 'self' blob: https://cdn.jsdelivr.net; child-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'",
      "dangerousDisableAssetCspModification": ["style-src"],
      "capabilities": ["default", "canvas-browser-annotation", "browser-preview-annotation"],
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/.lotus/canvas-themes/**",
          "$HOME/.lotus-dev/canvas-themes/**"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhBRDY4NzkxMjQyQTYwNkIKUldScllDb2trWWZXaWdoVGRaV0liM2pPZktwUjBEOGZmWE9PbXJLTmhJNDc5Z1lrQWx5bVF1Ty8K",
      "endpoints": [
        "https://github.com/alwisofwan1/lotus/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "macOS": {
      "entitlements": "Entitlements.plist",
      "infoPlist": "Info.plist",
      "files": {
        "MacOS/lotus-sessiond": "target/release/lotus-sessiond"
      }
    }
  }
}
