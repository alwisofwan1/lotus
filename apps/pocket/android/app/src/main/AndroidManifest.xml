<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pocket is ~90% an HTTP + WebSocket client (ADR-1), so this belongs in the main
         manifest and not only in the debug and profile ones Flutter generates. Those
         cover `flutter run`; a release APK built from them has no network at all, and
         ADR-9 makes a sideloaded release APK the MVP distribution. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- The gate in front of every mutation (ADR-8, ADR-12 no. 4). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>
    <!-- Background wake-ups (ADR-4). Required from Android 13, and inert until
         something actually asks for the grant — declared now so the FCM step that is
         waiting on a Firebase project is plugin work only, with no manifest surprise
         discovered at that point. A wake-up the operator cannot see is not a wake-up. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Scanning the pairing QR (ADR-5 step 1). Declared here as well as in
         `mobile_scanner`'s own manifest, which does merge it in: the merge is what
         grants it, and this line is what makes it visible to somebody reading this
         file to find out what the app can do. The `uses-feature` half matters more —
         without `required="false"` the merged manifest would advertise a camera as a
         hard requirement, and the whole point is that typing still works without one. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <!-- Dictation (PLAN §7 no. 9). The audio does not stay audio for long: it is posted
         to the paired host, transcribed with the host's own key, and the clip is deleted
         from the cache in the same call — ADR-11 keeps provider keys off the phone, so
         the phone is a microphone and nothing more. `required="false"` for the same
         reason as the camera: typing still works without one, and a device with no
         microphone must still be able to install this. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-feature android:name="android.hardware.microphone" android:required="false"/>
    <!-- `android:label` is what the operator reads, not what the package is called. It
         appears in the launcher, in the notification shade above every wake-up, and in
         the system permission dialog — which is where the template's raw `lotus_pocket`
         was caught: "Allow lotus_pocket to send you notifications?" -->
    <application
        android:label="Lotus Pocket"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- Off until there is a reason to be on (ADR-4).
             Measured 2026-08-07: with the default, a fresh install that had paired with
             nothing at all had already registered itself with Google's FCM servers and
             held a token — the SDK does that at first launch on its own. That
             contradicts the posture this product holds everywhere else, where nothing
             leaves the tailnet until it must. `FirebasePushTokens.requestToken` turns it
             on, which happens only after a host is paired and the operator has granted
             notifications. The setting persists once enabled, so this costs one call. -->
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- A link in an agent's reply opens in whatever browser the phone has. Without
             this, `canLaunchUrl` answers false on API 30+ — package visibility hides
             every browser from us — and the row that offers to open it would be drawn
             and then refuse. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="http"/>
        </intent>
    </queries>
</manifest>
