    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">
    <group android:pivotX="54.0" android:pivotY="54.0" android:rotation="0">
        <path android:pathData="M48.114,36.911 a5.886,12.911 0 1,0 11.772,0 a5.886,12.911 0 1,0 -11.772,0"
            android:strokeColor="#F7F2EA" android:strokeWidth="2.2" android:strokeAlpha="0.88" />
    </group>
