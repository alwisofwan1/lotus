---
/**
 * The Lotus desktop app's privacy policy — the page Google's OAuth consent screen links to
 * (plans/google-connector, ADR-0044). The website's own notice stays at /privacy/.
 *
 * Text lives in `copy.ts` (`privacyDesktop`). Same renderer rule as /privacy/: everything is
 * escaped, backticked terms become `<code>` (the scope names are literals), and bare https URLs
 * become links — nothing else in a legal sentence can turn into markup.
 */
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import Base from "../../layouts/Base.astro";
import { privacyDesktop, site } from "../../copy";

function render(text: string): string {
  return text
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/`([^`]+)`/g, "<code>$1</code>")
    .replace(/(https:\/\/[\w./-]+[\w/-])/g, '<a href="$1" rel="noreferrer">$1</a>');
}
---

<Base
  title={`${privacyDesktop.title} — ${site.name}`}
  description="What the Lotus desktop app does with your Google account, and where your data goes."
>
  <SiteHeader />
  <main class="wrap">
    <div class="shell inner">
      <p class="tag">Updated {privacyDesktop.updated}</p>
      <h1>{privacyDesktop.title}</h1>
      <p class="lede" set:html={render(privacyDesktop.intro)} />

      {
        privacyDesktop.sections.map((section) => (
          <section>
            <h2>{section.heading}</h2>
            {section.body.map((para) => (
              <p set:html={render(para)} />
            ))}
          </section>
        ))
      }

      <p class="back"><a class="btn" href="/privacy/">The website's privacy notice</a></p>
    </div>
  </main>
  <SiteFooter />
</Base>

<style>
  .wrap {
    padding-block: 4.5rem 5rem;
  }
  .inner {
    max-inline-size: 44rem;
  }
  h1 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2rem, 5vw, 2.75rem);
    letter-spacing: -0.035em;
    line-height: 1.05;
    margin-block: 0.7rem 1.4rem;
    text-wrap: balance;
  }
  .lede {
    font-size: 1.0625rem;
    line-height: 1.65;
    max-inline-size: 38rem;
  }
  section {
    margin-block-start: 2.6rem;
    border-block-start: 1px solid var(--hair);
    padding-block-start: 1.4rem;
  }
  h2 {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.0625rem;
    letter-spacing: -0.015em;
    margin-block-end: 0.9rem;
  }
  section p {
    color: var(--dim);
    font-size: 0.9375rem;
    line-height: 1.75;
    margin-block-end: 0.9rem;
  }
  section p:last-child {
    margin-block-end: 0;
  }
  code {
    font-family: var(--font-mono);
    font-size: 0.875em;
    color: var(--ink);
  }
  .back {
    margin-block-start: 3.2rem;
  }
  section a {
    color: var(--ink);
    overflow-wrap: anywhere;
  }
</style>
