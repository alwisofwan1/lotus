---
/**
 * The privacy notice, as a real page rather than a footer anchor.
 *
 * It used to be `#legal`, which pointed at the footer — and the footer holds a
 * mailing address and three links, no notice. So the "Privacy" link beside the
 * signup form led to nothing, which is exactly the arrangement GDPR Art. 13(1)
 * exists to prevent: consent collected next to a promise of information that was
 * never there.
 *
 * A separate URL is also the practical shape. Buttondown's confirmation mail has to
 * link the notice, and a mail client cannot follow a fragment into a page it is not
 * displaying.
 *
 * Text lives in `copy.ts` with the rest of the site's words. Backticked terms in
 * the body are rendered as code, because the channel tags genuinely are literals.
 */
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Base from "../layouts/Base.astro";
import { privacy, site } from "../copy";

/** The only markup allowed through: `code`. Everything else stays literal text, so
 *  a stray angle bracket in a legal sentence can never become an element. */
function withCode(text: string): string {
  return text
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/`([^`]+)`/g, "<code>$1</code>");
}
---

<Base
  title={`${privacy.title} — ${site.name}`}
  description="What happens to the email address you give the Lotus waiting list, and nothing else."
>
  <SiteHeader />
  <main class="wrap">
    <div class="shell inner">
      <p class="tag">Updated {privacy.updated}</p>
      <h1>{privacy.title}</h1>
      <p class="lede">{privacy.intro}</p>
      <p class="lede">{privacy.desktop.before}<a href={privacy.desktop.href}>{privacy.desktop.link}</a>.</p>

      {
        privacy.sections.map((section) => (
          <section>
            <h2>{section.heading}</h2>
            {section.body.map((para) => (
              <p set:html={withCode(para)} />
            ))}
          </section>
        ))
      }

      <p class="back"><a class="btn" href="/#top">Back to the start</a></p>
    </div>
  </main>
  <SiteFooter />
</Base>

<style>
  .wrap {
    padding-block: 4.5rem 5rem;
  }
  .inner {
    max-inline-size: 44rem;
  }
  h1 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2rem, 5vw, 2.75rem);
    letter-spacing: -0.035em;
    line-height: 1.05;
    margin-block: 0.7rem 1.4rem;
    text-wrap: balance;
  }
  .lede {
    font-size: 1.0625rem;
    line-height: 1.65;
    max-inline-size: 38rem;
  }
  section {
    margin-block-start: 2.6rem;
    border-block-start: 1px solid var(--hair);
    padding-block-start: 1.4rem;
  }
  h2 {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.0625rem;
    letter-spacing: -0.015em;
    margin-block-end: 0.9rem;
  }
  section p {
    color: var(--dim);
    font-size: 0.9375rem;
    line-height: 1.75;
    margin-block-end: 0.9rem;
  }
  section p:last-child {
    margin-block-end: 0;
  }
  code {
    font-family: var(--font-mono);
    font-size: 0.875em;
    color: var(--ink);
  }
  .back {
    margin-block-start: 3.2rem;
  }
</style>
