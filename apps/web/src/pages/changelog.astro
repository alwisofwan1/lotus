---
/**
 * The changelog: every desktop release from `src/releases/*.md`, newest first, then the
 * hand-written log from before the update feed. Each release has an anchor (`#v0.2.3`) that
 * the GitHub Release body links to.
 *
 * Earlier: the build log, on a page of its own since the revamp (2026-09-30).
 *
 * It used to be the last section of the home page. It is still promised by the waitlist
 * fineprint ("one build log every two weeks"), so it has to stay one click away — the nav
 * and the footer both link here. Words live in `copy.ts` (`buildLog`).
 */
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Base from "../layouts/Base.astro";
import { buildLog, site } from "../copy";
import { releases, releaseUrl } from "../lib/releases";
---

<Base title={`${buildLog.title} — ${site.name}`} description={buildLog.description}>
  <link slot="head" rel="alternate" type="application/rss+xml" title={`${site.name} releases`} href="/changelog.xml" />
  <SiteHeader />
  <main class="wrap">
    <div class="shell inner">
      <p class="tag">{buildLog.title}</p>
      <h1>{buildLog.heading}</h1>
      <p class="lede">{buildLog.lede} <a href="/changelog.xml">{buildLog.rss}</a></p>

      <div class="rels">
        {
          releases.map(({ version, date, title, Content }) => (
            <article class="rel" id={`v${version}`} aria-labelledby={`t-${version}`}>
              <p class="ver">
                <a href={`#v${version}`}>{version}</a>
                <time datetime={date}>{date}</time>
              </p>
              <div class="notes">
                <h2 id={`t-${version}`}>{title}</h2>
                <Content />
                <a class="files" href={releaseUrl(version)}>{buildLog.files} · v{version}</a>
              </div>
            </article>
          ))
        }
      </div>

      <h2 class="earlier">{buildLog.earlier}</h2>
      <ol class="log">
        {
          buildLog.entries.map((entry) => (
            <li class="entry">
              <time datetime={entry.date}>{entry.date}</time>
              <span class:list={["kind", `k-${entry.kind.toLowerCase().replace(/\s+/g, "-")}`]}>{entry.kind}</span>
              <div>
                <h2>{entry.title}</h2>
                <p>{entry.body}</p>
              </div>
            </li>
          ))
        }
      </ol>

      <p class="back"><a class="btn" href="/">Back to the start</a></p>
    </div>
  </main>
  <SiteFooter />
</Base>

<style>
  .wrap {
    padding-block: clamp(3.5rem, 8vw, 6rem);
  }
  .inner {
    max-width: 52rem;
  }
  h1 {
    margin-top: 0.9rem;
    font-size: clamp(2rem, 4.6vw, 3.1rem);
    letter-spacing: -0.035em;
    max-width: 20ch;
  }
  .lede {
    margin-top: 1rem;
    color: var(--dim);
    max-width: 52ch;
  }
  .rels {
    margin-top: 2.75rem;
    border-top: 1px solid var(--hair);
  }
  .rel {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr);
    gap: 0.5rem 1.5rem;
    padding: 2rem 0;
    border-bottom: 1px solid var(--hair);
    scroll-margin-top: 5rem;
  }
  .ver {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-family: var(--font-mono);
  }
  .ver a {
    font-size: 1.125rem;
    color: var(--ink);
    text-decoration: none;
  }
  .ver time {
    font-size: 0.75rem;
    color: var(--faint);
  }
  .rel:target .ver a {
    color: var(--run);
  }
  .notes h2 {
    font-size: 1.375rem;
  }
  .notes :global(h3) {
    margin-top: 1.25rem;
    font: 500 0.6875rem/1 var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--faint);
  }
  .notes :global(p),
  .notes :global(ul) {
    margin-top: 0.6rem;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--dim);
  }
  .notes :global(ul) {
    list-style: disc;
    padding-left: 1.1rem;
  }
  .notes :global(li::marker) {
    color: var(--faint);
  }
  .notes :global(li + li) {
    margin-top: 0.4rem;
  }
  .notes :global(strong) {
    color: var(--ink);
    font-weight: 600;
  }
  .files {
    display: inline-block;
    margin-top: 1.1rem;
    font: 0.75rem var(--font-mono);
    color: var(--faint);
  }
  .earlier {
    margin-top: 3.5rem;
    font: 500 0.6875rem/1 var(--font-mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--faint);
  }
  .log {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    border-top: 1px solid var(--hair);
  }
  .entry {
    display: grid;
    grid-template-columns: 7.5rem 7rem minmax(0, 1fr);
    gap: 0.4rem 1rem;
    padding: 1.4rem 0;
    border-bottom: 1px solid var(--hair);
  }
  time,
  .kind {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: var(--faint);
    padding-top: 0.2rem;
  }
  .kind {
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }
  .k-shipped {
    color: var(--run);
  }
  .k-in-progress {
    color: var(--wait);
  }
  h2 {
    font-size: 1.0625rem;
    letter-spacing: -0.015em;
  }
  .entry p {
    margin-top: 0.35rem;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--dim);
  }
  .back {
    margin-top: 2.5rem;
  }
  @media (max-width: 640px) {
    .rel {
      grid-template-columns: 1fr;
    }
    .ver {
      flex-direction: row;
      align-items: baseline;
      gap: 0.75rem;
    }
    .entry {
      grid-template-columns: auto 1fr;
    }
    .entry > div {
      grid-column: 1 / -1;
    }
  }
</style>
