---
/**
 * Section 01: the claim, one action, four checkable facts, and the agents Lotus launches.
 *
 * Redesign 2026-11-21: centred and quiet. The product starts
 * right below, in the pinned window (sections/Story.astro), so the hero carries no picture.
 *
 * The form renders with zero JavaScript and posts directly (Buttondown's requirement).
 * Whether it can post at all is the seam's call (lib/waitlist/config.ts); while no account is
 * configured the field is left out and the download links are the only action.
 *
 * Entrance motion animates `transform` and `filter` only. Nothing here starts invisible,
 * because a frozen animation must never hide the headline (CHECKPOINTS.md, rv-1).
 *
 * Keep notes like this one in frontmatter. An `<!-- HTML comment -->` in the template is
 * copied verbatim into `dist/`, and a retired claim once shipped that way.
 */
import { AGENT_CLIS, hero, proof } from "../copy";
import { describePlacement } from "../lib/waitlist";
import DownloadButtons from "../components/DownloadButtons.astro";

const placement = describePlacement("hero");
const words = hero.headline.lead.split(" ");
---

<section class="hero" id="top">
  <div class="field" aria-hidden="true"></div>
  <div class="glow" aria-hidden="true"></div>
  <div class="shell hero-in">
    <p class="chip rise"><span class="pip" aria-hidden="true"></span>{hero.eyebrow.join(" · ")}</p>

    <h1>
      <span class="lead">{words.map((w, i) => <span class="w" style={`--i:${i}`}>{w}</span>)}</span>
      <span class="turn">{hero.headline.turn}</span>
    </h1>

    <p class="lede rise">{hero.lede}</p>

    <div class="rise">
      <DownloadButtons />
      {
        placement.open && (
          <form class="cta" action={placement.plan.action} method={placement.plan.method}>
            {placement.plan.hidden.map((f) => <input type="hidden" name={f.name} value={f.value} />)}
            <div class="field-in">
              <input
                type="email"
                name="email"
                required
                placeholder="you@company.com"
                aria-label="Work email"
                autocomplete="email"
                inputmode="email"
                maxlength="254"
              />
              <button class="btn" type="submit">{hero.cta.submit}</button>
            </div>
            <p class="fine">{hero.fineprint} <a href="/privacy/">Privacy</a>.</p>
          </form>
        )
      }
    </div>

    <dl class="facts rise">
      {
        proof.map((f) => (
          <div>
            <dt>{f.value}</dt>
            <dd>{f.label}</dd>
          </div>
        ))
      }
    </dl>
    <p class="works rise">
      <span class="tag">{hero.agents.label}</span>
      {AGENT_CLIS.map((name) => <span class="a">{name}</span>)}
      <em>{hero.agents.own}</em>
    </p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(5rem, 13vh, 9rem) clamp(3rem, 7vh, 5rem);
    text-align: center;
    overflow: hidden;
  }
  .field {
    position: absolute;
    inset: -10% -10% 0;
    pointer-events: none;
    background-image: radial-gradient(circle at 1px 1px, rgb(247 243 238 / 0.14) 0.9px, transparent 1.2px);
    background-size: 22px 22px;
    mask-image: radial-gradient(60% 55% at 50% 40%, #000 0%, transparent 75%);
    opacity: 0.55;
  }
  .glow {
    position: absolute;
    left: 50%;
    top: 58%;
    width: min(820px, 100%);
    height: 420px;
    transform: translate(-50%, -50%);
    pointer-events: none;
    background: radial-gradient(closest-side, rgb(180 155 255 / 0.1), transparent);
    filter: blur(10px);
  }
  .hero-in {
    position: relative;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.4rem 0.85rem 0.4rem 0.7rem;
    border-radius: 999px;
    border: 1px solid var(--hair-2);
    font-size: 13px;
    color: var(--dim);
    background: rgb(30 27 25 / 0.6);
  }
  .pip {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--ask);
  }
  h1 {
    font-size: clamp(3rem, 8.4vw, 6.6rem);
    letter-spacing: -0.055em;
    line-height: 0.94;
    margin-top: 1.8rem;
  }
  .lead {
    display: block;
  }
  .w {
    display: inline-block;
    margin-right: 0.22em;
  }
  .w:last-child {
    margin-right: 0;
  }
  .turn {
    display: block;
    color: var(--faint);
  }
  .lede {
    margin: 1.6rem auto 0;
    max-width: 42ch;
    font-size: clamp(16px, 1.6vw, 18.5px);
    color: var(--dim);
  }
  .field-in {
    display: flex;
    gap: 0.5rem;
    justify-content: center;
    margin-top: 1.4rem;
  }
  .field-in input {
    min-width: 0;
    padding: 0.7rem 1rem;
    border-radius: 999px;
    border: 1px solid var(--hair-2);
    background: var(--surface);
    color: var(--ink);
  }
  .fine {
    margin-top: 0.6rem;
    font-size: 12px;
    color: var(--faint);
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin: clamp(3.5rem, 8vh, 5.5rem) 0 0;
    border-top: 1px solid var(--hair);
    text-align: left;
  }
  .facts div {
    padding: 1.1rem 1.2rem 0 0;
  }
  .facts div + div {
    padding-left: 1.2rem;
    border-left: 1px solid var(--hair);
  }
  .facts dt {
    font: 500 15px/1.2 var(--font-sans);
    margin-bottom: 0.3rem;
  }
  .facts dd {
    margin: 0;
    font-size: 13px;
    color: var(--faint);
  }
  .works {
    margin-top: 1.6rem;
    font: 400 12.5px/1.9 var(--font-mono);
    color: var(--dim);
    text-align: left;
  }
  .works .tag {
    margin-right: 1rem;
    white-space: nowrap;
  }
  /* inline-block: each name stays whole, and the row may break between names. */
  .a {
    display: inline-block;
    white-space: nowrap;
  }
  .a::after {
    content: " ·";
    color: var(--faint);
    margin-right: 0.35em;
  }
  .works em {
    font-style: normal;
    color: var(--faint);
  }
  @media (max-width: 760px) {
    .facts {
      grid-template-columns: 1fr 1fr;
    }
    .facts div,
    .facts div + div {
      padding: 1rem 0.8rem 1rem 0;
      border-left: 0;
      border-bottom: 1px solid var(--hair);
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .rise {
      animation: rise 1s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    .w {
      animation: word 1.1s cubic-bezier(0.16, 1, 0.3, 1) both;
      animation-delay: calc(var(--i) * 60ms + 120ms);
    }
    .turn {
      animation: turn 1.4s cubic-bezier(0.16, 1, 0.3, 1) 0.9s both;
    }
    @keyframes rise {
      from {
        transform: translateY(22px);
      }
    }
    @keyframes word {
      from {
        transform: translateY(0.32em);
        filter: blur(6px);
      }
    }
    @keyframes turn {
      from {
        color: var(--ink);
      }
    }
  }
</style>
