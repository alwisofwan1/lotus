---
/**
 * The product, told once (redesign 2026-11-21).
 *
 * Chapters on the left; one app window pinned on the right that changes scene as the
 * chapters scroll past: Canvas → hand-off → Chat → Factory → Automations. Below 900px the
 * window sits on top, keeps its desktop layout and is scaled to fit (public/motion.js sets
 * `--k`).
 *
 * Without JavaScript the first scene is shown and every chapter is readable, so nothing on
 * the page depends on the script. The window is one picture to a screen reader
 * (`role="img"`); the chapters carry the words.
 *
 * Factory and Automations open from the rail in the app, not from the mode switch, so no
 * mode is lit for them (`mode: null`).
 */
import { story, type Line } from "../copy";

const { canvas: cv, handoff: ho, permission: pm, chat, factory: fa, automations: au } = story;
const first = story.chapters[0];
const d = (ms: number) => `--d:${ms}`;
---

<div class="shell story" id="story">
  <div class="chapters">
    {
      story.chapters.map((c, i) => (
        <article class:list={["ch", { on: i === 0 }]} data-scene={c.id} data-mode={c.mode ?? ""} data-status={c.status}>
          <span class="num">
            {String(i + 1).padStart(2, "0")} · {c.kicker}
          </span>
          <h2>{c.title}</h2>
          <p>{c.body}</p>
          {c.points.length > 0 && (
            <ul>
              {c.points.map((p) => (
                <li>{p}</li>
              ))}
            </ul>
          )}
        </article>
      ))
    }
  </div>

  <div class="pin">
    <div class="win" data-win data-scene={first.id} role="img" aria-label={story.label}>
      <div class="wtop">
        <div class="lights"><i></i><i></i><i></i></div>
        <div class="msw" data-msw>
          <b class="pill"></b>
          {story.modes.map((m) => <span data-m={m} class:list={{ on: m === first.mode }}>{m}</span>)}
        </div>
        <div class="wst"><span class="s"></span><span data-status>{first.status}</span></div>
      </div>

      <div class="stage">
        <div class="scene dots on" data-s="canvas">
          <div class="rail-tools"><i></i><i></i><i></i><i></i><i></i></div>
          <div class="frm" data-d style={d(100)}><span><span class="s ask"></span>{cv.frame}</span></div>
          <div class="node n-nara" data-d style={d(250)}>
            <div class="nh"><span class="s run"></span>{cv.nara.name} <em>· {cv.nara.runner}</em></div>
            <div class="nb">{cv.nara.lines.map((l: Line) => <div class={l.tone}>{l.text}</div>)}</div>
          </div>
          <div class="node n-bima" data-d style={d(400)}>
            <div class="nh"><span class="s idle"></span>{cv.bima.name} <em>· {cv.bima.runner}</em></div>
            <div class="nb">{cv.bima.lines.map((l) => <div class={l.tone}>{l.text}</div>)}</div>
          </div>
          <div class="node n-term" data-d style={d(550)}>
            <div class="nh"><span class="s run"></span>❯ {cv.terminal.name}</div>
            <div class="nb">{cv.terminal.lines.map((l) => <div class={l.tone}>{l.text}</div>)}</div>
          </div>
          <div class="node n-music" data-d style={d(700)}>
            <div class="nh"><span class="s run"></span>♪ {cv.music.name} <em>· {cv.music.source}</em></div>
            <div class="nb track-row">
              <span class="cover"></span>
              <div><div class="ink t">{cv.music.title}</div><div class="ch-name">{cv.music.channel}</div></div>
            </div>
          </div>
          <div class="node n-note" data-d style={d(850)}>
            <div class="nh">{cv.note.label}</div>
            <div class="nb">{cv.note.body}</div>
          </div>
          <div class="composer" data-d style={d(500)}>
            <span class="to">{cv.target}</span><span class="typed">{cv.nlHint}</span><span class="mic"></span>
          </div>
        </div>

        <div class="scene dots" data-s="handoff">
          <div class="frm full"><span><span class="s ask"></span>{cv.frame}</span></div>
          <svg class="wire" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
            <path d="M41 24 C 46 24, 46 24, 51 24" vector-effect="non-scaling-stroke"></path>
          </svg>
          <span class="wlabel" data-d style={d(900)}>{ho.wire}</span>
          <div class="node n-nara2">
            <div class="nh"><span class="s link"></span>{cv.nara.name} <em>· {cv.nara.runner}</em><em class="end">{ho.done}</em></div>
            <div class="nb">{ho.nara.map((l: Line, i) => <div class={l.tone} data-d={i > 1 ? "" : undefined} style={i > 1 ? d(200 + i * 120) : undefined}>{l.text}</div>)}</div>
          </div>
          <div class="node n-bima2 ask-node">
            <div class="nh"><span class="s ask"></span>{cv.bima.name} <em>· {cv.bima.runner}</em><em class="end ask-t">{ho.needsYou}</em></div>
            <div class="nb">
              {ho.bima.map((l, i) => <div class={l.tone} data-d style={d(1300 + i * 450)}>{l.text}</div>)}
              <div class="perm" data-d style={d(3300)}>
                <div class="ink">{pm.title}</div>
                <div class="mute">  {pm.command}</div>
                <div class="ink q">{pm.question}</div>
                {pm.options.map((o, i) => <div class:list={{ sel: i === 0 }}>{i === 0 ? "❯" : " "} {o.key}. {o.label}</div>)}
              </div>
            </div>
          </div>
        </div>

        <div class="scene" data-s="chat">
          <div class="chat">
            <div class="threads">
              <div class="srch">{chat.search}</div>
              <h6>{chat.groups.running}</h6>
              <div class="thr on">{chat.parent.title}<small>{chat.parent.sub}</small></div>
              {chat.kids.map((k, i) => <div class="thr kid" data-d style={d(1200 + i * 300)}>{k.title}<small>{k.model}</small></div>)}
              <h6>{chat.groups.earlier}</h6>
              {chat.earlier.map((t) => <div class="thr">{t.title}<small>{t.sub}</small></div>)}
            </div>
            <div class="conv">
              <div class="crumb">{story.project} · {chat.parent.title}</div>
              <div class="you" data-d style={d(200)}>{chat.ask}</div>
              <div data-d style={d(800)}>{chat.reply}</div>
              {
                chat.kids.map((k, i) => (
                  <div class="kidcard" data-d style={d(1200 + i * 300)}>
                    <span class:list={["s", i === 0 ? "link" : "run"]}></span>
                    <b>{k.title}</b>
                    {k.model}
                    <em>{chat.merged}</em>
                  </div>
                ))
              }
              <div class="gauge" data-d style={d(400)}>{chat.placeholder}<span>{chat.gauge}</span><i></i></div>
            </div>
          </div>
        </div>

        <div class="scene" data-s="factory">
          <div class="fac">
            <div class="fac-h"><b>{fa.name}</b> · <code>{fa.ticket}</code> {fa.title}</div>
            <div class="track">
              <span class="bar"></span>
              {fa.steps.map((s, i) => <div class:list={["st", { last: i === fa.steps.length - 1 }]} style={`--k:${i}`}><i></i><b>{s.title}</b>{s.body}</div>)}
            </div>
            <div class="flog">
              {
                fa.log.map(([stage, text, em], i) => (
                  <div data-d style={d([1700, 2300, 2800, 3200, 4100, 5200][i])}>
                    <span>{stage}</span>
                    {text}
                    {em && (stage === "pr" || i === 0 ? <b>{em}</b> : <i>{em}</i>)}
                  </div>
                ))
              }
            </div>
            <div class="pr" data-d style={d(5600)}>
              <div class="pr-t"><span class="s ask"></span>{fa.pr}<em>{fa.needsYou}</em></div>
              <div class="meta">{fa.meta.map(([k, v, rest]) => <span>{k} <b>{v}</b>{rest && ` ${rest}`}</span>)}</div>
            </div>
          </div>
        </div>

        <div class="scene" data-s="automations">
          <div class="auto">
            <div class="rule">
              {au.rule.map((r, i) => <div data-d style={d(150 + i * 200)}><b>{r.tok}</b>{r.text}</div>)}
              <div class="draft" data-d style={d(1200)}>
                <b>{au.draft.label}</b>
                <span class="dq">{au.draft.text}</span>
                <span class="dbtn"><span>{au.draft.send}</span><span>{au.draft.edit}</span></span>
              </div>
            </div>
            <div class="inbox">
              <div class="ib-h"><b>{au.inbox.title}</b><span>{au.inbox.running}</span></div>
              {
                au.rows.map((r, i) => (
                  <div class:list={["row", { ask: r.state === "needs you" }]} data-d style={d(300 + i * 200)}>
                    <span class:list={["s", r.state === "running" ? "run" : r.state === "needs you" ? "ask" : "idle"]}></span>
                    <div><b>{r.title}</b><small>{r.sub}</small></div>
                    <em class:list={{ r: r.state === "running", a: r.state === "needs you" }}>{r.state}</em>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .story {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.45fr);
    gap: clamp(2rem, 4vw, 4rem);
    padding-block: 2rem 6rem;
  }
  .chapters {
    padding-bottom: 20vh;
    min-width: 0;
  }
  .ch {
    min-height: 88vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  /* Dimmed only once the script runs, so without it every chapter reads at full contrast. */
  :global(.js) .ch:not(.on) {
    opacity: 0.28;
  }
  .num {
    font: 500 12px/1 var(--font-mono);
    color: var(--faint);
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .num::after {
    content: "";
    height: 1px;
    width: 2.5rem;
    background: var(--hair-2);
  }
  .ch h2 {
    font-size: clamp(2rem, 3.6vw, 3rem);
    letter-spacing: -0.04em;
    margin: 1rem 0 1.1rem;
  }
  .ch p {
    color: var(--dim);
    max-width: 38ch;
    font-size: 16.5px;
  }
  .ch ul {
    list-style: none;
    margin: 1.4rem 0 0;
    padding: 0;
    font-size: 14px;
    color: var(--faint);
  }
  .ch li {
    padding: 0.45rem 0;
    border-top: 1px solid var(--hair);
    display: flex;
    gap: 0.6rem;
  }
  .ch li::before {
    content: "—";
    color: var(--idle);
  }
  .pin {
    position: sticky;
    top: calc(4rem + 9vh);
    height: min(76vh, 640px);
    align-self: start;
    min-width: 0;
  }

  .win {
    position: relative;
    height: 100%;
    border-radius: 16px;
    background: var(--sunk);
    border: 1px solid var(--hair-2);
    overflow: hidden;
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.06) inset,
      0 60px 120px -60px rgb(0 0 0 / 0.95),
      0 0 0 1px rgb(0 0 0 / 0.4);
  }
  .wtop {
    position: relative;
    z-index: 3;
    height: 42px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding-inline: 14px;
    border-bottom: 1px solid var(--hair);
    background: var(--sunk);
  }
  .lights {
    display: flex;
    gap: 7px;
  }
  .lights i {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--raised);
  }
  .msw {
    position: relative;
    display: inline-flex;
    padding: 3px;
    border-radius: 9px;
    background: var(--surface);
    border: 1px solid var(--hair);
  }
  .msw span {
    position: relative;
    z-index: 1;
    padding: 0.28rem 0.8rem;
    font-size: 12px;
    color: var(--faint);
    transition: color 0.4s;
  }
  .msw span.on {
    color: var(--ink);
  }
  .pill {
    position: absolute;
    z-index: 0;
    top: 3px;
    bottom: 3px;
    left: 3px;
    width: var(--w, 0);
    transform: translateX(var(--x, 0));
    border-radius: 7px;
    background: var(--raised);
    transition:
      transform 0.55s cubic-bezier(0.16, 1, 0.3, 1),
      width 0.55s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.3s;
  }
  .msw[data-none] .pill {
    opacity: 0;
  }
  /* No script: light the first tab without the sliding pill. */
  :global(html:not(.js)) .msw span.on {
    background: var(--raised);
    border-radius: 7px;
  }
  .wst {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 12px;
    color: var(--faint);
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    border: 1px solid var(--hair);
    white-space: nowrap;
  }
  .wst .s {
    background: var(--run);
    transition: background 0.4s;
  }
  .win[data-scene="handoff"] .wst .s,
  .win[data-scene="factory"] .wst .s {
    background: var(--ask);
  }

  .s {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    display: inline-block;
    flex: none;
  }
  .s.run { background: var(--run); }
  .s.ask { background: var(--ask); }
  .s.idle { background: var(--idle); }
  .s.link { background: #7dd3fc; }
  .ink { color: var(--ink); }
  .mute { color: #77726d; }
  .run { color: var(--run); }

  .stage {
    position: absolute;
    inset: 42px 0 0;
  }
  .scene {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transform: scale(0.985);
    transition:
      opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.8s cubic-bezier(0.16, 1, 0.3, 1),
      visibility 0s 0.6s;
  }
  .scene.on {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition:
      opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.1s,
      transform 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.1s,
      visibility 0s;
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .scene [data-d] {
      opacity: 0;
      transform: translateY(8px);
      transition:
        opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1),
        transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }
    :global(.js) .scene.on [data-d] {
      opacity: 1;
      transform: none;
      transition-delay: calc(var(--d) * 1ms);
    }
  }

  .dots {
    background-image: radial-gradient(circle at 1px 1px, rgb(247 243 238 / 0.075) 1px, transparent 1.3px);
    background-size: 18px 18px;
  }
  .rail-tools {
    position: absolute;
    left: 14px;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 5px;
    border-radius: 10px;
    background: var(--surface);
    border: 1px solid var(--hair);
  }
  .rail-tools i {
    width: 22px;
    height: 22px;
    border-radius: 6px;
    display: grid;
    place-items: center;
  }
  .rail-tools i::after {
    content: "";
    width: 9px;
    height: 9px;
    border: 1.4px solid var(--faint);
    border-radius: 2px;
  }
  .rail-tools i:first-child {
    background: var(--raised);
  }
  .rail-tools i:nth-child(3)::after {
    border-radius: 50%;
  }
  .frm {
    position: absolute;
    left: 9%;
    top: 9%;
    right: 4%;
    bottom: 26%;
    border: 1px solid rgb(180 155 255 / 0.28);
    border-radius: 14px;
    background: rgb(180 155 255 / 0.025);
  }
  .frm.full {
    bottom: 6%;
  }
  .frm > span {
    position: absolute;
    top: -1.55rem;
    left: 0.2rem;
    font-size: 12px;
    color: var(--dim);
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .node {
    position: absolute;
    border-radius: 10px;
    background: var(--surface);
    border: 1px solid var(--hair-2);
    overflow: hidden;
    font: 11.5px/1.65 var(--font-mono);
    color: var(--dim);
    text-align: left;
  }
  .nb > div {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .nh {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.5rem 0.7rem;
    border-bottom: 1px solid var(--hair);
    font: 500 12px/1 var(--font-sans);
    color: var(--ink);
  }
  .nh em {
    font-style: normal;
    font-weight: 400;
    color: var(--faint);
  }
  .nh .end {
    margin-left: auto;
  }
  .nh .ask-t {
    color: var(--ask);
  }
  .nb {
    padding: 0.55rem 0.7rem;
  }
  .ask-node {
    border-color: var(--ask);
    box-shadow: 0 0 0 4px rgb(180 155 255 / 0.08);
  }
  .n-nara { left: 12%; top: 16%; width: 30%; }
  .n-bima { left: 45%; top: 16%; width: 34%; }
  .n-term { left: 12%; top: 58%; width: 30%; }
  .n-music { left: 45%; top: 58%; width: 34%; }
  .n-note {
    left: 82%;
    top: 16%;
    width: 15%;
    background: #efe9dd;
    color: #4a4339;
    border-color: transparent;
    font: 12px/1.45 var(--font-sans);
  }
  .n-note .nh {
    color: #2a251f;
    border-color: rgb(0 0 0 / 0.08);
  }
  .n-nara2 { left: 12%; top: 16%; width: 29%; height: 52%; }
  .n-bima2 { left: 51%; top: 16%; width: 45%; }
  .track-row {
    display: flex;
    gap: 0.6rem;
    align-items: center;
    font-family: var(--font-sans);
  }
  .track-row .t {
    font-size: 12px;
    line-height: 1.3;
  }
  .ch-name {
    font-size: 11px;
    color: #d9a75a;
  }
  .cover {
    width: 34px;
    height: 34px;
    border-radius: 6px;
    background: linear-gradient(135deg, #3b2a5c, #1b2a4a 60%, #d9a75a);
    flex: none;
  }
  .composer {
    position: absolute;
    left: 18%;
    right: 18%;
    bottom: 6%;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 0.55rem 0.5rem 0.9rem;
    border-radius: 14px;
    background: var(--raised);
    border: 1px solid var(--hair-2);
    font-size: 13px;
    color: var(--faint);
    box-shadow: 0 18px 40px -20px rgb(0 0 0 / 0.8);
  }
  .typed {
    color: var(--ink);
    white-space: nowrap;
    overflow: hidden;
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .typed {
      max-width: 0;
      border-right: 1.5px solid var(--ink);
    }
    :global(.js) .scene.on .typed {
      animation:
        type 1.6s steps(26) 0.9s forwards,
        caret 0.8s step-end infinite;
    }
  }
  @keyframes type {
    to {
      max-width: 26ch;
    }
  }
  @keyframes caret {
    50% {
      border-color: transparent;
    }
  }
  .composer .mic {
    margin-left: auto;
    width: 26px;
    height: 26px;
    border-radius: 8px;
    background: var(--surface);
    display: grid;
    place-items: center;
  }
  .composer .mic::after {
    content: "";
    width: 6px;
    height: 10px;
    border-radius: 4px;
    border: 1.4px solid var(--dim);
  }
  .to {
    font: 500 12px/1 var(--font-sans);
    color: var(--ask);
  }

  .wire {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    overflow: visible;
  }
  .wire path {
    fill: none;
    stroke: var(--ask);
    stroke-width: 1.5;
    stroke-dasharray: 5 5;
    opacity: 0.8;
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .wire path {
      stroke-dashoffset: 200;
      opacity: 0;
    }
    :global(.js) .scene.on .wire path {
      animation:
        wire 1.2s cubic-bezier(0.16, 1, 0.3, 1) 0.5s forwards,
        flow 1s linear 1.7s infinite;
    }
  }
  @keyframes wire {
    to {
      opacity: 0.8;
      stroke-dashoffset: 0;
    }
  }
  @keyframes flow {
    from {
      stroke-dashoffset: 0;
    }
    to {
      stroke-dashoffset: -20;
    }
  }
  .wlabel {
    position: absolute;
    left: 41.9%;
    top: 19.5%;
    font: 500 10px/1 var(--font-mono);
    color: var(--ask);
    letter-spacing: 0.06em;
  }
  .perm {
    margin-top: 0.5rem;
    padding: 0.55rem 0.65rem;
    border: 1px solid var(--ask);
    border-radius: 7px;
    background: rgb(180 155 255 / 0.04);
  }
  .perm .q {
    margin-top: 0.35rem;
  }
  .perm .sel {
    color: var(--ink);
    background: rgb(180 155 255 / 0.14);
    border-radius: 3px;
  }

  .chat {
    display: grid;
    grid-template-columns: 34% 1fr;
    height: 100%;
    text-align: left;
  }
  .threads {
    border-right: 1px solid var(--hair);
    padding: 0.9rem 0.7rem;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    font-size: 12.5px;
  }
  .srch {
    padding: 0.45rem 0.6rem;
    border-radius: 8px;
    background: var(--surface);
    color: var(--faint);
    font-size: 12px;
    margin-bottom: 0.6rem;
  }
  .threads h6 {
    margin: 0.7rem 0.45rem 0.3rem;
    font: 500 10px var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--faint);
