# @lotus/host environment variables
# Copy to .env and fill in values before running.
#
# Every variable here is read at the config boundary (`src/core/config.ts`) and
# injected — no class reads process.env itself.

# ── Active adapter (default: mobile) ──────────────────────────────────────────
# The Telegram adapter was removed on 2026-08-02 (ADR-2); `mobile` is what the
# `/m/*` façade serves to Lotus Pocket.
ADAPTER=mobile

# ── Deployment mode ───────────────────────────────────────────────────────────
# client     — adapter only, proxies a running Lotus desktop app (default)
# standalone — adapter + embedded Standalone Host, for a VPS with no desktop
# LOTUS_MODE=client

# ── Lotus API (auto-discovered from ~/.lotus/api-server.json by default) ──────
# Override when running the host on a different machine or a custom port.
# LOTUS_API_URL=http://127.0.0.1:9877
# LOTUS_API_KEY=your_api_key_here

# ── Where the mobile façade listens (default: 127.0.0.1:8787) ─────────────────
# Loopback means no phone can reach it. Pick the tailnet interface for a real
# device; the desktop's Mobile Access tab offers the candidates and never 0.0.0.0.
# LOTUS_MOBILE_BIND=100.64.0.3:8787

# ── Label this host shows in Pocket (default: the machine hostname) ───────────
# LOTUS_HOST_LABEL=MacBook

# ── Background push, Android/FCM (ADR-4) ──────────────────────────────────────
# **On a desktop install you do not set this at all.** Drop the file at
#   <state dir>/fcm-service-account.json      (~/.lotus/ or ~/.lotus-dev/)
# beside `api-server.key`, and the host finds it. The reason is not convenience:
# Lotus spawns this runtime with an explicit allow-list environment, and Lotus
# launched from Finder has no shell environment — so exporting the variable below
# in a terminal would reach nothing and push would stay silently off.
#
# This override exists for a VPS running the host directly, which does have a shell.
#
# Either way it must be the Firebase **service account** JSON — not
# google-services.json, which is the client config and cannot sign anything. With no
# file at all, `hostCaps` will not claim `push`, so the app never registers a token it
# would wait on forever.
#
# The private key stays here: the phone only ever receives a *registration* token,
# which names where to deliver. chmod 600 the file — the host warns if it is
# readable beyond its owner.
#
# What the wake-up carries: one fixed sentence, "An agent needs you". Paths, agent
# names and commands never go to Google; the app fetches those over the tailnet.
# LOTUS_FCM_SERVICE_ACCOUNT=/Users/you/.lotus/fcm-service-account.json
