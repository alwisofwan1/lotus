{
  "name": "lotus",
  "version": "0.1.0",
  "private": true,
  "description": "Lotus meta-repository — desktop workbench, mobile client, and the host layer they share.",
  "//": "Sengaja TIDAK memakai bun/npm workspaces: apps/pocket adalah Flutter, dikelola pub, jadi tidak ada dependency graph lintas-app yang bisa dibagi atau dioptimasi. Script di bawah murni pass-through supaya perintah lama tetap jalan dari root. Sumber kebenaran tiap app ada di package.json miliknya sendiri.",
  "scripts": {
    "validate": "bash tools/gates.sh",
    "preinstall": "node tools/no-root-install.mjs",
    "install:all": "cd apps/desktop && bun install && cd ../../packages/host && bun install && cd ../../apps/web && bun install",
    "dev": "cd apps/desktop && bun run dev",
    "build": "cd apps/desktop && bun run build",
    "lint": "cd apps/desktop && bun run lint",
    "test": "cd apps/desktop && bun run test",
    "test:watch": "cd apps/desktop && bun run test:watch",
    "tauri": "cd apps/desktop && bun run tauri",
    "tauri:dev": "cd apps/desktop && bun run tauri:dev",
    "tauri:build": "cd apps/desktop && bun run tauri:build",
    "tauri:build:exec": "cd apps/desktop && bun run tauri:build:exec",
    "tauri:build:mac": "cd apps/desktop && bun run tauri:build:mac",
    "release": "cd apps/desktop && bun run release",
    "release:mac": "cd apps/desktop && bun run release:mac",
    "release:notes": "cd apps/desktop && bun run release:notes",
    "tauri:dev:win": "cd apps/desktop && bun run tauri:dev:win",
    "tauri:build:win": "cd apps/desktop && bun run tauri:build:win",
    "setup:linux": "cd apps/desktop && bun run setup:linux",
    "clean:rust-temp": "cd apps/desktop && bun run clean:rust-temp",
    "clean:stale": "cd apps/desktop && bun run clean:stale",
    "diagnostics:report": "node tools/session-history-report/report.mjs",
    "diagnostics:loadgen": "node tools/session-history-report/loadgen.mjs",
    "diagnostics:subscribe": "node tools/session-history-report/subscriber.mjs",
    "host:test": "cd packages/host && bun run test",
    "host:build": "cd packages/host && bun run build",
    "host:build:vps": "apps/desktop/scripts/build-sessiond-linux.sh && cd packages/host && bun run build:vps",
    "web:dev": "cd apps/web && bun run dev",
    "web:build": "cd apps/web && bun run build",
    "web:preview": "cd apps/web && bun run preview",
    "web:check": "cd apps/web && bun run check",
    "pocket:test": "cd apps/pocket && flutter test",
    "pocket:analyze": "cd apps/pocket && flutter analyze",
    "pocket:dev": "apps/pocket/scripts/dev.sh",
    "pocket:emulator": "apps/pocket/scripts/emulator.sh",
    "pocket:release": "apps/pocket/scripts/release.sh",
    "web:test": "cd apps/web && bun run test",
    "verify:ci-filters": "node tools/verify-ci-filters.mjs",
    "test:all": "bun run test && bun run host:test && bun run web:test && bun run pocket:test"
  }
}
